# ============================================================
# AgentPay Environment Configuration
# ============================================================

# AI Provider: 'gemini' or 'rule-based' (fallback works out-of-the-box without keys)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# PayPal Sandbox REST Orders API v2
# Get Sandbox credentials from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret

# Channel3 Product Discovery API
CHANNEL3_API_KEY=your_channel3_api_key

